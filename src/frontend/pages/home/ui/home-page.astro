---
import * as stylex from "@stylexjs/stylex";
import type { CollectionEntry } from "astro:content";

import { styles } from "./home-page.stylex";

interface Props {
  articles: Array<CollectionEntry<"articles">>;
}

const { articles } = Astro.props;
const latestUpdate = articles[0]?.data.updatedAt;
const heroStyle = stylex.props(styles.hero);
const titleStyle = stylex.props(styles.title);
const leadStyle = stylex.props(styles.lead);
const statsStyle = stylex.props(styles.stats);
const statValueStyle = stylex.props(styles.statValue);
const statLabelStyle = stylex.props(styles.statLabel);
const sectionHeadingStyle = stylex.props(styles.sectionHeading);
const emptyStateStyle = stylex.props(styles.emptyState);
const articleListStyle = stylex.props(styles.articleList);
---

<section class={heroStyle.className} style={heroStyle.style}>
  <h1 class={titleStyle.className} style={titleStyle.style}>
    Dev Wiki
  </h1>
  <p class={leadStyle.className} style={leadStyle.style}>
    開発で学んだ内容を、後から読み返せる形で残します。
  </p>
  <ul class={statsStyle.className} style={statsStyle.style}>
    <li>
      <span class={statValueStyle.className} style={statValueStyle.style}>
        {articles.length}
      </span>
      <span class={statLabelStyle.className} style={statLabelStyle.style}>
        記事
      </span>
    </li>
    {latestUpdate && (
      <li>
        <span class={statValueStyle.className} style={statValueStyle.style}>
          {latestUpdate.toLocaleDateString("ja-JP")}
        </span>
        <span class={statLabelStyle.className} style={statLabelStyle.style}>
          最終更新
        </span>
      </li>
    )}
  </ul>
</section>

<section aria-labelledby="recent-articles">
  <h2 id="recent-articles" class={sectionHeadingStyle.className} style={sectionHeadingStyle.style}>
    最近更新した記事
  </h2>
  {articles.length === 0 ? (
    <p class={emptyStateStyle.className} style={emptyStateStyle.style}>
      記事はまだありません。
    </p>
  ) : (
    <ul class={articleListStyle.className} style={articleListStyle.style}>
      {articles.map((article) => {
        const itemStyle = stylex.props(styles.articleItem);
        const linkStyle = stylex.props(styles.articleLink);
        const summaryStyle = stylex.props(styles.summary);
        const updatedAtStyle = stylex.props(styles.updatedAt);

        return (
          <li class={itemStyle.className} style={itemStyle.style}>
            <a
              class={linkStyle.className}
              style={linkStyle.style}
              href={`/articles/${article.data.slug}/`}
            >
              {article.data.title}
            </a>
            <p class={summaryStyle.className} style={summaryStyle.style}>
              {article.data.summary}
            </p>
            <time
              class={updatedAtStyle.className}
              style={updatedAtStyle.style}
              datetime={article.data.updatedAt.toISOString()}
            >
              {article.data.updatedAt.toLocaleDateString("ja-JP")}
            </time>
          </li>
        );
      })}
    </ul>
  )}
</section>
