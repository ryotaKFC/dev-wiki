{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/frontend/app/*"],
      "@entities/*": ["src/frontend/entities/*"],
      "@pages/*": ["src/frontend/pages/*"],
      "@shared/*": ["src/frontend/shared/*"],
      "@widgets/*": ["src/frontend/widgets/*"]
    }
  }
}
